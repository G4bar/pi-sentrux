          "name": "session_start"
        },
        {
          "description": "Re-scan and compare current state against session baseline. Returns diff showing what degraded.",
          "inputSchema": {
            "properties": {},
            "type": "object"
          },
          "name": "session_end"
        },
        {
          "description": "Get quality signal (0-1) with root cause breakdown (modularity, acyclicity, depth, equality, redundancy). Quality signal = geometric mean — maximize this ONE number.",
          "inputSchema": {
            "properties": {},
            "type": "object"
          },
          "name": "health"
        },
        {
          "description": "Check .sentrux/rules.toml architectural constraints. Returns pass/fail with specific violations.",
          "inputSchema": {
            "properties": {},
            "type": "object"
          },
          "name": "check_rules"
        },
        {
          "description": "Git history analysis: code churn, hotspots (churn x complexity), bus factor, change coupling. Raw data — not a score. Requires git history.",
          "inputSchema": {
            "properties": {
              "days": {
                "description": "Lookback window in days (default 90)",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "name": "git_stats"
        },
        {
          "description": "Get the Design Structure Matrix: NxN dependency matrix showing file relationships, clusters, and inversions.",
          "inputSchema": {
            "properties": {
              "format": {
                "description": "Output format: 'text' for ASCII matrix, 'stats' for summary statistics (default: stats)",
                "type": "string"
              }
            },
            "type": "object"
          },
          "name": "dsm"
        },
        {
          "description": "Find high-risk source files with zero test coverage. Cross-references test file detection with import graph and complexity.",
          "inputSchema": {
            "properties": {
              "limit": {
                "description": "Top-N riskiest untested files (default 20)",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "name": "test_gaps"
        }
      ]
    }
